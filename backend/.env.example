PORT=5000
NODE_ENV=development

# AI API Key configuration (e.g. Gemini, OpenAI, etc.)
GEMINI_API_KEY=your_gemini_api_key_here

# Aiven MySQL 8.4 — required for chat history persistence
MYSQL_HOST=your-service.aivencloud.com
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=defaultdb

# Aiven CA Certificate — paste full PEM string (from Aiven Console > Overview > Download CA Certificate)
# Required for verified SSL. Never commit the actual certificate to source control.
MYSQL_CA_CERT="-----BEGIN CERTIFICATE-----
...paste Aiven CA PEM here...
-----END CERTIFICATE-----"
